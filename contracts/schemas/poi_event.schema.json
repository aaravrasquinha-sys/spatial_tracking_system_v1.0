{
  "title": "poi.v1 event message",
  "type": "object",
  "required": [
    "type",
    "event",
    "id",
    "t"
  ],
  "properties": {
    "type": {
      "const": "event"
    },
    "event": {
      "enum": [
        "track_start",
        "track_confirmed",
        "track_lost",
        "track_end",
        "calib_suspect",
        "id_switch",
        "identity_new",
        "identity_matched",
        "identity_merged",
        "identity_conflict",
        "identity_swapped"
      ]
    },
    "id": {
      "type": "integer"
    },
    "t": {
      "type": "number"
    },
    "detail": {
      "type": "string"
    },
    "person_id": {
      "type": "integer"
    },
    "from_person_id": {
      "type": "integer"
    }
  }
}